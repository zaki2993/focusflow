import QtQuick
import QtQuick.Controls
import Quickshell
import qs.Commons
import qs.Ui
import "Model.js" as Model

// Focus Flow Panel UI — Redesigned 3-Tab Interface: Focus, Tasks, Settings.
Panel {
  id: root
  moduleName: "zakarch.focusflow"
  ipcTarget: "zakarch.focusflow.panel"
  manageIpc: false

  property var anchorItem: null
  property var hostWidget: null
  readonly property var barIdentity: hostWidget || root

  readonly property var svc: bar && bar.shell ? bar.shell.serviceFor("zakarch.focusflow") : null

  readonly property color fg: bar ? bar.foreground : Color.foreground
  readonly property string ff: bar ? bar.fontFamily : Style.font.family

  // ── Phase-aware accent colors ───────────────────────────────────────────────
  readonly property color phaseColor: svc && svc.phase === "break" ? "#10b981"
    : svc && svc.phase === "focus" ? Color.accent
    : Color.accent

  // ── Active tab (0: Focus, 1: Tasks, 2: Settings) ───────────────────────────
  property int activeTab: 0

  // ── Tasks Filter & Priority ───────────────────────────────────────────────
  property string taskFilter: "all"
  property string editingTaskId: ""
  property string editingTaskTitle: ""
  property string editingTaskPriority: "medium"
  property string newTaskPriority: "medium"
  property bool sortByPriority: false

  readonly property var taskListModel: {
    var list = (svc && svc.tasks) ? svc.tasks : []
    var f = root.taskFilter
    var filtered = list
    if (f === "active") filtered = list.filter(function(t) { return !t.done })
    else if (f === "done") filtered = list.filter(function(t) { return t.done })

    if (root.sortByPriority) {
      return filtered.slice().sort(function(a, b) {
        if (a.done !== b.done) return a.done ? 1 : -1
        var diff = Model.priorityWeight(b.priority) - Model.priorityWeight(a.priority)
        if (diff !== 0) return diff
        return 0
      })
    }
    return filtered
  }

  // ── Pomodoro computations ──────────────────────────────────────────────────
  readonly property string heroTime: svc
    ? (svc.phase === "idle" ? Model.formatRemaining(svc.focusMinutes * 60000) : svc.displayTime)
    : "25:00"

  readonly property string heroLabel: svc
    ? (svc.phase === "focus" ? "FOCUS" : (svc.phase === "break" ? "BREAK" : "READY"))
    : "READY"

  readonly property string statusLine: !svc ? ""
    : svc.phase === "idle" ? "Ready to flow"
    : svc.running ? "Timer running" : "Paused"

  readonly property string primaryLabel: !svc ? "󰐊 Start Focus"
    : svc.phase === "idle" ? "󰐊 Start Focus"
    : svc.running ? "󰏤 Pause" : "󰐊 Resume"

  readonly property real progress: svc && svc.totalSeconds > 0
    ? Math.min(1.0, svc.elapsedSeconds / svc.totalSeconds) : 0

  function primaryAction() {
    if (!svc) return
    if (svc.phase === "idle") svc.startFocus()
    else if (svc.running) svc.pause()
    else svc.resume()
  }

  function switchPanel(direction) {
    if (root.bar && typeof root.bar.switchPanelFrom === "function")
      return root.bar.switchPanelFrom(root.barIdentity, direction)
    return false
  }

  KeyboardPanel {
    id: panel
    anchorItem: root.anchorItem
    owner: root.barIdentity
    bar: root.bar
    open: root.opened
    centerOnBar: true
    focusTarget: keyCatcher
    contentWidth: panel.fittedContentWidth(Style.space(430))
    contentHeight: panel.fittedContentHeight(mainCol.implicitHeight)

    PanelKeyCatcher {
      id: keyCatcher
      anchors.fill: parent
      onCloseRequested: root.close()
      onTabRequested: function(d) { root.switchPanel(d) }
      onTextKey: function(t) {
        if (!keyCatcher.activeFocus) return

        if (t === "1") root.activeTab = 0
        else if (t === "2") root.activeTab = 1
        else if (t === "3") root.activeTab = 2
        else if ((t === "s" || t === "S") && root.activeTab === 0) {
          if (root.svc && root.svc.phase === "idle") root.svc.startFocus()
        } else if ((t === "p" || t === "P") && root.activeTab === 0) {
          if (root.svc) { if (root.svc.running) root.svc.pause(); else root.svc.resume() }
        } else if ((t === "r" || t === "R") && root.activeTab === 0) {
          if (root.svc) root.svc.reset()
        }
      }

      Column {
        id: mainCol
        width: parent.width
        spacing: Style.space(12)

        // ════════════ SEGMENTED TAB BAR ═════════════════════════════════════
        Item {
          width: parent.width
          height: Style.space(42)

          // Background pill
          Rectangle {
            anchors.fill: parent
            radius: height / 2
            color: Qt.rgba(root.fg.r, root.fg.g, root.fg.b, 0.04)
            border.width: 1
            border.color: Qt.rgba(root.fg.r, root.fg.g, root.fg.b, 0.08)
          }

          // Sliding active indicator
          Rectangle {
            id: tabIndicator
            width: (parent.width - Style.space(8)) / 3
            height: parent.height - Style.space(6)
            y: Style.space(3)
            x: Style.space(4) + root.activeTab * width
            radius: height / 2
            color: Qt.rgba(Color.accent.r, Color.accent.g, Color.accent.b, 0.16)
            border.width: 1
            border.color: Qt.rgba(Color.accent.r, Color.accent.g, Color.accent.b, 0.35)

            Behavior on x { NumberAnimation { duration: 220; easing.type: Easing.OutCubic } }
          }

          Row {
            anchors.fill: parent
            anchors.margins: Style.space(4)

            // Tab 0: Focus
            Item {
              width: (parent.width) / 3
              height: parent.height

              Row {
                anchors.centerIn: parent
                spacing: Style.space(6)

                Text {
                  anchors.verticalCenter: parent.verticalCenter
                  text: "󱎫"
                  color: root.activeTab === 0 ? Color.accent : Qt.darker(root.fg, 1.4)
                  font.family: root.ff
                  font.pixelSize: Style.font.body
                  Behavior on color { ColorAnimation { duration: 180 } }
                }

                Text {
                  anchors.verticalCenter: parent.verticalCenter
                  text: "Focus"
                  color: root.activeTab === 0 ? root.fg : Qt.darker(root.fg, 1.4)
                  font.family: root.ff
                  font.pixelSize: Style.font.body
                  font.bold: root.activeTab === 0
                  Behavior on color { ColorAnimation { duration: 180 } }
                }

                // Pulsing dot when timer running
                Rectangle {
                  anchors.verticalCenter: parent.verticalCenter
                  width: Style.space(6); height: width
                  radius: width / 2
                  color: root.phaseColor
                  visible: root.svc && root.svc.running
                  SequentialAnimation on opacity {
                    loops: Animation.Infinite
                    running: root.svc && root.svc.running
                    NumberAnimation { from: 0.3; to: 1.0; duration: 800; easing.type: Easing.InOutQuad }
                    NumberAnimation { from: 1.0; to: 0.3; duration: 800; easing.type: Easing.InOutQuad }
                  }
                }
              }

              MouseArea {
                anchors.fill: parent
                cursorShape: Qt.PointingHandCursor
                onClicked: root.activeTab = 0
              }
            }

            // Tab 1: Tasks
            Item {
              width: (parent.width) / 3
              height: parent.height

              Row {
                anchors.centerIn: parent
                spacing: Style.space(6)

                Text {
                  anchors.verticalCenter: parent.verticalCenter
                  text: "󰏫"
                  color: root.activeTab === 1 ? Color.accent : Qt.darker(root.fg, 1.4)
                  font.family: root.ff
                  font.pixelSize: Style.font.body
                  Behavior on color { ColorAnimation { duration: 180 } }
                }

                Text {
                  anchors.verticalCenter: parent.verticalCenter
                  text: "Tasks"
                  color: root.activeTab === 1 ? root.fg : Qt.darker(root.fg, 1.4)
                  font.family: root.ff
                  font.pixelSize: Style.font.body
                  font.bold: root.activeTab === 1
                  Behavior on color { ColorAnimation { duration: 180 } }
                }

                // Open count badge pill
                Rectangle {
                  anchors.verticalCenter: parent.verticalCenter
                  visible: root.svc && root.svc.openCount > 0
                  width: taskBadgeText.implicitWidth + Style.space(8)
                  height: Style.space(16)
                  radius: height / 2
                  color: root.activeTab === 1
                    ? Qt.rgba(Color.accent.r, Color.accent.g, Color.accent.b, 0.25)
                    : Qt.rgba(root.fg.r, root.fg.g, root.fg.b, 0.08)

                  Text {
                    id: taskBadgeText
                    anchors.centerIn: parent
                    text: root.svc ? String(root.svc.openCount) : "0"
                    color: root.activeTab === 1 ? Color.accent : Qt.darker(root.fg, 1.4)
                    font.family: root.ff
                    font.pixelSize: Style.font.caption - 2
                    font.bold: true
                  }
                }
              }

              MouseArea {
                anchors.fill: parent
                cursorShape: Qt.PointingHandCursor
                onClicked: root.activeTab = 1
              }
            }

            // Tab 2: Settings
            Item {
              width: (parent.width) / 3
              height: parent.height

              Row {
                anchors.centerIn: parent
                spacing: Style.space(6)

                Text {
                  anchors.verticalCenter: parent.verticalCenter
                  text: "󰒓"
                  color: root.activeTab === 2 ? Color.accent : Qt.darker(root.fg, 1.4)
                  font.family: root.ff
                  font.pixelSize: Style.font.body
                  Behavior on color { ColorAnimation { duration: 180 } }
                }

                Text {
                  anchors.verticalCenter: parent.verticalCenter
                  text: "Settings"
                  color: root.activeTab === 2 ? root.fg : Qt.darker(root.fg, 1.4)
                  font.family: root.ff
                  font.pixelSize: Style.font.body
                  font.bold: root.activeTab === 2
                  Behavior on color { ColorAnimation { duration: 180 } }
                }
              }

              MouseArea {
                anchors.fill: parent
                cursorShape: Qt.PointingHandCursor
                onClicked: root.activeTab = 2
              }
            }
          }
        }

        // ════════════ TAB PAGES CONTAINER ═══════════════════════════════════
        Item {
          width: parent.width
          implicitHeight: root.activeTab === 0 ? focusPage.implicitHeight
                        : root.activeTab === 1 ? tasksPage.implicitHeight
                        : settingsPage.implicitHeight

          Behavior on implicitHeight { NumberAnimation { duration: 180; easing.type: Easing.OutQuad } }

          // ──────────────────────────────────────────────────────────────────
          // TAB 0: FOCUS PAGE
          // ──────────────────────────────────────────────────────────────────
          Column {
            id: focusPage
            width: parent.width
            spacing: Style.space(12)
            visible: root.activeTab === 0

            // ── Active Task Hero Banner ─────────────────────────────────────
            Rectangle {
              width: parent.width
              height: Style.space(56)
              radius: Style.cornerRadius * 1.3
              color: root.svc && root.svc.activeTask
                ? Qt.rgba(Color.accent.r, Color.accent.g, Color.accent.b, 0.09)
                : Qt.rgba(root.fg.r, root.fg.g, root.fg.b, 0.04)
              border.width: 1
              border.color: root.svc && root.svc.activeTask
                ? Qt.rgba(Color.accent.r, Color.accent.g, Color.accent.b, 0.28)
                : Qt.rgba(root.fg.r, root.fg.g, root.fg.b, 0.08)
              Behavior on color { ColorAnimation { duration: 250 } }
              Behavior on border.color { ColorAnimation { duration: 250 } }

              Row {
                anchors.fill: parent
                anchors.leftMargin: Style.space(12)
                anchors.rightMargin: Style.space(10)
                spacing: Style.space(10)

                // Quick complete checkbox button
                Rectangle {
                  anchors.verticalCenter: parent.verticalCenter
                  width: Style.space(26); height: width
                  radius: Style.cornerRadius * 0.7
                  color: (root.svc && root.svc.activeTask && root.svc.activeTask.done)
                    ? Color.accent
                    : (root.svc && root.svc.activeTask)
                      ? Qt.rgba(Color.accent.r, Color.accent.g, Color.accent.b, 0.18)
                      : Qt.rgba(root.fg.r, root.fg.g, root.fg.b, 0.06)
                  border.width: 1.5
                  border.color: (root.svc && root.svc.activeTask) ? Color.accent : Qt.darker(root.fg, 1.4)

                  Text {
                    anchors.centerIn: parent
                    text: (root.svc && root.svc.activeTask && root.svc.activeTask.done) ? "✓" : (root.svc && root.svc.activeTask ? "󰌵" : "󰏫")
                    color: (root.svc && root.svc.activeTask && root.svc.activeTask.done) ? Color.background : ((root.svc && root.svc.activeTask) ? Color.accent : Qt.darker(root.fg, 1.4))
                    font.family: root.ff
                    font.pixelSize: 13
                  }

                  MouseArea {
                    anchors.fill: parent
                    cursorShape: Qt.PointingHandCursor
                    onClicked: {
                      if (root.svc && root.svc.activeTask) {
                        root.svc.toggleTask(root.svc.activeTaskId)
                      } else {
                        root.activeTab = 1
                      }
                    }
                  }
                }

                // Task title and metadata
                Column {
                  width: parent.width - Style.space(136)
                  anchors.verticalCenter: parent.verticalCenter
                  spacing: 2

                  Row {
                    width: parent.width
                    spacing: Style.space(6)

                    // Priority Badge for Active Task
                    Rectangle {
                      id: activePrioBadge
                      visible: root.svc && root.svc.activeTask !== null
                      anchors.verticalCenter: parent.verticalCenter
                      height: Style.space(16)
                      width: activePrioBadgeRow.implicitWidth + Style.space(8)
                      radius: Style.space(8)
                      color: {
                        var p = (root.svc && root.svc.activeTask) ? (root.svc.activeTask.priority || "medium") : "medium"
                        if (p === "high") return Qt.rgba(0.937, 0.267, 0.267, 0.18)
                        if (p === "low") return Qt.rgba(0.231, 0.510, 0.965, 0.18)
                        return Qt.rgba(0.961, 0.620, 0.043, 0.18)
                      }
                      border.width: 1
                      border.color: (root.svc && root.svc.activeTask) ? Model.priorityColor(root.svc.activeTask.priority) : "transparent"

                      Row {
                        id: activePrioBadgeRow
                        anchors.centerIn: parent
                        spacing: Style.space(2)
                        Text {
                          text: (root.svc && root.svc.activeTask) ? Model.priorityIcon(root.svc.activeTask.priority) : ""
                          color: (root.svc && root.svc.activeTask) ? Model.priorityColor(root.svc.activeTask.priority) : "transparent"
                          font.family: root.ff
                          font.pixelSize: 9
                        }
                        Text {
                          text: (root.svc && root.svc.activeTask) ? Model.priorityLabel(root.svc.activeTask.priority) : ""
                          color: (root.svc && root.svc.activeTask) ? Model.priorityColor(root.svc.activeTask.priority) : "transparent"
                          font.family: root.ff
                          font.pixelSize: Style.font.caption * 0.85
                          font.bold: true
                        }
                      }
                    }

                    Text {
                      width: parent.width - (activePrioBadge.visible ? (activePrioBadge.width + Style.space(6)) : 0)
                      text: root.svc && root.svc.activeTask ? root.svc.activeTask.title : "No task linked to session"
                      color: (root.svc && root.svc.activeTask && root.svc.activeTask.done) ? Qt.darker(root.fg, 1.6) : root.fg
                      font.family: root.ff
                      font.pixelSize: Style.font.body
                      font.bold: root.svc && root.svc.activeTask !== null
                      font.strikeout: root.svc && root.svc.activeTask && root.svc.activeTask.done
                      elide: Text.ElideRight
                    }
                  }

                  Text {
                    text: root.svc && root.svc.activeTask
                      ? "󰔛 " + (root.svc.activeTask.pomos || 0) + " pomos · " + (root.svc.activeTask.done ? "Done ✓" : "Click checkbox to finish")
                      : (root.svc && root.svc.openCount > 0 ? "Select from " + root.svc.openCount + " open tasks" : "Create tasks in the Tasks tab")
                    color: Qt.darker(root.fg, 1.5)
                    font.family: root.ff
                    font.pixelSize: Style.font.caption
                  }
                }

                Button {
                  anchors.verticalCenter: parent.verticalCenter
                  text: root.svc && root.svc.activeTask ? "Unlink" : "Select"
                  foreground: root.fg
                  accent: Color.accent
                  fontFamily: root.ff
                  fontSize: Style.font.caption
                  onClicked: {
                    if (root.svc && root.svc.activeTask) root.svc.setActiveTask("")
                    else root.activeTab = 1
                  }
                }
              }
            }

            // ── Circular Timer Instrument ───────────────────────────────────
            Item {
              width: parent.width
              height: Style.space(225)

              // Soft ambient glow ring
              Rectangle {
                anchors.centerIn: parent
                width: Style.space(196)
                height: width
                radius: width / 2
                color: "transparent"
                border.width: 1.5
                border.color: root.phaseColor
                opacity: (root.svc && root.svc.running) ? 0.22 : 0
                Behavior on opacity { NumberAnimation { duration: 350 } }
              }

              // High-precision canvas ring
              Canvas {
                id: timerRing
                anchors.centerIn: parent
                width: Style.space(184)
                height: Style.space(184)

                readonly property real prog: root.progress
                readonly property color ringColor: root.phaseColor
                readonly property color trackColor: Qt.rgba(root.fg.r, root.fg.g, root.fg.b, 0.08)

                onProgChanged: requestPaint()
                onRingColorChanged: requestPaint()
                onTrackColorChanged: requestPaint()

                onPaint: {
                  var ctx = getContext("2d")
                  ctx.clearRect(0, 0, width, height)
                  var cx = width / 2
                  var cy = height / 2
                  var r = Math.min(width, height) / 2 - 9
                  var lineWidth = 7

                  // Track ring
                  ctx.beginPath()
                  ctx.arc(cx, cy, r, 0, Math.PI * 2)
                  ctx.lineWidth = lineWidth
                  ctx.strokeStyle = trackColor
                  ctx.stroke()

                  // Active progress arc
                  if (prog > 0) {
                    var startAngle = -Math.PI / 2
                    var endAngle = startAngle + (Math.PI * 2 * Math.min(1.0, Math.max(0.001, prog)))
                    ctx.beginPath()
                    ctx.arc(cx, cy, r, startAngle, endAngle)
                    ctx.lineWidth = lineWidth
                    ctx.strokeStyle = ringColor
                    ctx.lineCap = "round"
                    ctx.stroke()
                  }
                }
              }

              // Dial Center Content
              Column {
                anchors.centerIn: parent
                spacing: Style.space(4)

                // Phase Chip
                Rectangle {
                  anchors.horizontalCenter: parent.horizontalCenter
                  width: phaseRow.implicitWidth + Style.space(16)
                  height: Style.space(22)
                  radius: height / 2
                  color: Qt.rgba(root.phaseColor.r, root.phaseColor.g, root.phaseColor.b, 0.12)
                  border.width: 1
                  border.color: Qt.rgba(root.phaseColor.r, root.phaseColor.g, root.phaseColor.b, 0.30)

                  Row {
                    id: phaseRow
                    anchors.centerIn: parent
                    spacing: Style.space(4)

                    Text {
                      text: root.svc && root.svc.phase === "focus" ? "󱎫" : (root.svc && root.svc.phase === "break" ? "󰅶" : "󰒲")
                      color: root.phaseColor
                      font.family: root.ff
                      font.pixelSize: Style.font.caption
                    }
                    Text {
                      text: root.heroLabel
                      color: root.phaseColor
                      font.family: root.ff
                      font.pixelSize: Style.font.caption - 1
                      font.bold: true
                      font.letterSpacing: 1.5
                    }
                  }
                }

                // Big Clock Digits
                Text {
                  anchors.horizontalCenter: parent.horizontalCenter
                  text: root.heroTime
                  color: root.fg
                  font.family: root.ff
                  font.pixelSize: 46
                  font.bold: true
                  font.letterSpacing: 1.5
                }

                // Status message
                Text {
                  anchors.horizontalCenter: parent.horizontalCenter
                  text: root.statusLine
                  color: Qt.darker(root.fg, 1.45)
                  font.family: root.ff
                  font.pixelSize: Style.font.caption
                }
              }

              // ── Time Nudge Buttons (Active / Paused) ───────────────────────
              Row {
                anchors.bottom: parent.bottom
                anchors.horizontalCenter: parent.horizontalCenter
                spacing: Style.space(6)
                visible: root.svc && root.svc.phase !== "idle"

                Button {
                  text: "−5m"
                  foreground: Qt.darker(root.fg, 1.3)
                  accent: Color.accent
                  fontFamily: root.ff
                  fontSize: Style.font.caption
                  onClicked: if (root.svc) root.svc.nudgeMinutes(-5)
                }
                Button {
                  text: "−1m"
                  foreground: Qt.darker(root.fg, 1.3)
                  accent: Color.accent
                  fontFamily: root.ff
                  fontSize: Style.font.caption
                  onClicked: if (root.svc) root.svc.nudgeMinutes(-1)
                }
                Button {
                  text: "+1m"
                  foreground: Qt.darker(root.fg, 1.3)
                  accent: Color.accent
                  fontFamily: root.ff
                  fontSize: Style.font.caption
                  onClicked: if (root.svc) root.svc.nudgeMinutes(1)
                }
                Button {
                  text: "+5m"
                  foreground: Qt.darker(root.fg, 1.3)
                  accent: Color.accent
                  fontFamily: root.ff
                  fontSize: Style.font.caption
                  onClicked: if (root.svc) root.svc.nudgeMinutes(5)
                }
              }

              // ── Quick Presets (When Idle) ─────────────────────────────────
              Row {
                anchors.bottom: parent.bottom
                anchors.horizontalCenter: parent.horizontalCenter
                spacing: Style.space(6)
                visible: root.svc && root.svc.phase === "idle"

                Repeater {
                  model: [15, 25, 45, 60, 90, 180]
                  delegate: Button {
                    required property int modelData
                    text: modelData >= 60 ? (modelData / 60) + "h" : modelData + "m"
                    selected: root.svc && root.svc.focusMinutes === modelData
                    foreground: root.fg
                    accent: Color.accent
                    fontFamily: root.ff
                    fontSize: Style.font.caption
                    onClicked: if (root.svc) root.svc.focusMinutes = modelData
                  }
                }
              }
            }

            // ── Primary Action Controls ─────────────────────────────────────
            Row {
              width: parent.width
              spacing: Style.space(8)

              Button {
                id: primaryBtn
                width: (parent.width - Style.space(16)) * 0.52
                text: root.primaryLabel
                fontFamily: root.ff
                foreground: (root.svc && root.svc.running) ? root.fg : Color.background
                accent: Color.accent
                selected: !(root.svc && root.svc.running)
                onClicked: root.primaryAction()
              }

              Button {
                width: (parent.width - Style.space(16)) * 0.28
                text: !root.svc ? "󰅶 Break"
                  : root.svc.phase === "focus" ? "󰅶 Take Break"
                  : root.svc.phase === "break" ? "󱎫 Skip Focus"
                  : "󰅶 Break"
                fontFamily: root.ff
                foreground: root.fg
                accent: Color.accent
                onClicked: {
                  if (!root.svc) return
                  if (root.svc.phase === "break") root.svc.startFocus()
                  else root.svc.startBreak()
                }
              }

              Button {
                width: (parent.width - Style.space(16)) * 0.20
                text: "󰜉 Reset"
                fontFamily: root.ff
                foreground: Qt.darker(root.fg, 1.3)
                accent: Color.accent
                onClicked: if (root.svc) root.svc.reset()
              }
            }

            // ── Today's Flow & Progress Dashboard ───────────────────────────
            Rectangle {
              width: parent.width
              height: statsCol.implicitHeight + Style.space(22)
              radius: Style.cornerRadius * 1.3
              color: Qt.rgba(root.fg.r, root.fg.g, root.fg.b, 0.04)
              border.width: 1
              border.color: Qt.rgba(root.fg.r, root.fg.g, root.fg.b, 0.07)

              Column {
                id: statsCol
                anchors.fill: parent
                anchors.margins: Style.space(12)
                spacing: Style.space(10)

                // Top summary row
                Row {
                  width: parent.width
                  Item {
                    width: parent.width * 0.5
                    height: Style.space(20)
                    Row {
                      spacing: Style.space(6)
                      Text {
                        anchors.verticalCenter: parent.verticalCenter
                        text: "󰔛"
                        color: Color.accent
                        font.family: root.ff
                        font.pixelSize: Style.font.body
                      }
                      Text {
                        anchors.verticalCenter: parent.verticalCenter
                        text: "Today's Flow"
                        color: root.fg
                        font.family: root.ff
                        font.pixelSize: Style.font.body
                        font.bold: true
                      }
                    }
                  }

                  Text {
                    width: parent.width * 0.5
                    horizontalAlignment: Text.AlignRight
                    text: root.svc ? Model.formatMinutes(root.svc.totalFocusMinutesToday) + " focused" : "0m focused"
                    color: Qt.darker(root.fg, 1.4)
                    font.family: root.ff
                    font.pixelSize: Style.font.caption
                    anchors.verticalCenter: parent.verticalCenter
                  }
                }

                // Metrics row: Today, Week, Month
                Row {
                  width: parent.width
                  spacing: Style.space(6)

                  Rectangle {
                    width: (parent.width - Style.space(12)) / 3
                    height: Style.space(36)
                    radius: Style.cornerRadius
                    color: Qt.rgba(root.fg.r, root.fg.g, root.fg.b, 0.03)
                    Row {
                      anchors.centerIn: parent
                      spacing: Style.space(4)
                      Text { text: "󰔛"; color: Color.accent; font.family: root.ff; font.pixelSize: Style.font.caption }
                      Text { text: "Today: " + (root.svc ? root.svc.countToday : 0); color: root.fg; font.family: root.ff; font.pixelSize: Style.font.caption; font.bold: true }
                    }
                  }

                  Rectangle {
                    width: (parent.width - Style.space(12)) / 3
                    height: Style.space(36)
                    radius: Style.cornerRadius
                    color: Qt.rgba(root.fg.r, root.fg.g, root.fg.b, 0.03)
                    Row {
                      anchors.centerIn: parent
                      spacing: Style.space(4)
                      Text { text: "󰨲"; color: Qt.darker(root.fg, 1.5); font.family: root.ff; font.pixelSize: Style.font.caption }
                      Text { text: "Week: " + (root.svc ? root.svc.countWeek : 0); color: root.fg; font.family: root.ff; font.pixelSize: Style.font.caption; font.bold: true }
                    }
                  }

                  Rectangle {
                    width: (parent.width - Style.space(12)) / 3
                    height: Style.space(36)
                    radius: Style.cornerRadius
                    color: Qt.rgba(root.fg.r, root.fg.g, root.fg.b, 0.03)
                    Row {
                      anchors.centerIn: parent
                      spacing: Style.space(4)
                      Text { text: "󰸗"; color: Qt.darker(root.fg, 1.5); font.family: root.ff; font.pixelSize: Style.font.caption }
                      Text { text: "Month: " + (root.svc ? root.svc.countMonth : 0); color: root.fg; font.family: root.ff; font.pixelSize: Style.font.caption; font.bold: true }
                    }
                  }
                }
              }
            }
          }

          // ──────────────────────────────────────────────────────────────────
          // TAB 1: TASKS PAGE
          // ──────────────────────────────────────────────────────────────────
          Column {
            id: tasksPage
            width: parent.width
            spacing: Style.space(10)
            visible: root.activeTab === 1

            // ── Tasks Header & Actions ──────────────────────────────────────
            Row {
              width: parent.width

              Column {
                width: parent.width - headerActions.width - Style.space(10)
                spacing: 1
                Text {
                  text: "Task Management"
                  color: root.fg; font.family: root.ff
                  font.pixelSize: Style.font.heading; font.bold: true
                }
                Text {
                  text: root.svc
                    ? root.svc.openCount + " pending · " + root.svc.tasks.length + " total"
                    : "Task list"
                  color: Qt.darker(root.fg, 1.5)
                  font.family: root.ff; font.pixelSize: Style.font.caption
                }
              }

              Row {
                id: headerActions
                spacing: Style.space(6)

                Button {
                  id: sortPriorityBtn
                  text: root.sortByPriority ? "󰒺 Priority" : "󰒺 Sort"
                  selected: root.sortByPriority
                  foreground: root.sortByPriority ? Color.accent : Qt.darker(root.fg, 1.4)
                  accent: Color.accent
                  fontFamily: root.ff
                  fontSize: Style.font.caption
                  tooltipText: "Sort tasks by priority (High → Medium → Low)"
                  onClicked: root.sortByPriority = !root.sortByPriority
                }

                Button {
                  id: clearBtn
                  visible: root.svc && root.svc.tasks.some(function(t) { return t.done })
                  text: "󰆴 Clear Done"
                  foreground: Qt.darker(root.fg, 1.4)
                  accent: Color.accent
                  fontFamily: root.ff
                  fontSize: Style.font.caption
                  onClicked: if (root.svc) root.svc.clearCompletedTasks()
                }
              }
            }

            // ── Filter Segment Pills ────────────────────────────────────────
            Row {
              width: parent.width
              spacing: Style.space(6)

              Repeater {
                model: [
                  { id: "all", label: "All", count: root.svc ? root.svc.tasks.length : 0 },
                  { id: "active", label: "Pending", count: root.svc ? root.svc.openCount : 0 },
                  { id: "done", label: "Done", count: root.svc ? (root.svc.tasks.length - root.svc.openCount) : 0 }
                ]

                delegate: Button {
                  required property var modelData
                  text: modelData.label + " (" + modelData.count + ")"
                  selected: root.taskFilter === modelData.id
                  foreground: root.fg
                  accent: Color.accent
                  fontFamily: root.ff
                  fontSize: Style.font.caption
                  onClicked: root.taskFilter = modelData.id
                }
              }
            }

            // ── Task Input Card with Priority Selector ────────────────────────
            Rectangle {
              width: parent.width
              height: Style.space(78)
              radius: Style.cornerRadius * 1.2
              color: Qt.rgba(root.fg.r, root.fg.g, root.fg.b, 0.05)
              border.width: 1
              border.color: taskInput.activeFocus
                ? Color.accent
                : Qt.rgba(root.fg.r, root.fg.g, root.fg.b, 0.12)
              Behavior on border.color { ColorAnimation { duration: 180 } }

              Column {
                anchors.fill: parent
                anchors.margins: Style.space(8)
                anchors.leftMargin: Style.space(12)
                anchors.rightMargin: Style.space(8)
                spacing: Style.space(6)

                // Top: Input & Add Button
                Row {
                  width: parent.width
                  height: Style.space(30)
                  spacing: Style.space(8)

                  Text {
                    anchors.verticalCenter: parent.verticalCenter
                    text: "󰐕"
                    color: taskInput.activeFocus ? Color.accent : Qt.darker(root.fg, 1.5)
                    font.family: root.ff
                    font.pixelSize: Style.font.body
                  }

                  TextInput {
                    id: taskInput
                    anchors.verticalCenter: parent.verticalCenter
                    width: parent.width - addBtn.width - Style.space(32)
                    color: root.fg
                    font.family: root.ff
                    font.pixelSize: Style.font.body
                    clip: true
                    focus: root.activeTab === 1
                    selectByMouse: true

                    Text {
                      visible: !parent.text
                      anchors.verticalCenter: parent.verticalCenter
                      text: "What are you working on next?"
                      color: Qt.darker(root.fg, 1.7)
                      font: parent.font
                    }

                    onAccepted: {
                      if (root.svc && root.svc.addTask(text, root.newTaskPriority)) {
                        text = ""
                        root.newTaskPriority = "medium"
                      }
                    }
                  }

                  Button {
                    id: addBtn
                    anchors.verticalCenter: parent.verticalCenter
                    text: "Add"
                    foreground: root.fg
                    accent: Color.accent
                    fontFamily: root.ff
                    fontSize: Style.font.caption
                    onClicked: {
                      if (root.svc && root.svc.addTask(taskInput.text, root.newTaskPriority)) {
                        taskInput.text = ""
                        root.newTaskPriority = "medium"
                      }
                    }
                  }
                }

                // Bottom: Priority Selector Chips & Shorthand Tip
                Row {
                  width: parent.width
                  height: Style.space(24)
                  spacing: Style.space(6)

                  Text {
                    anchors.verticalCenter: parent.verticalCenter
                    text: "Priority:"
                    color: Qt.darker(root.fg, 1.6)
                    font.family: root.ff
                    font.pixelSize: Style.font.caption
                  }

                  // High Chip
                  Rectangle {
                    anchors.verticalCenter: parent.verticalCenter
                    height: Style.space(22)
                    width: highPillRow.implicitWidth + Style.space(12)
                    radius: Style.space(11)
                    color: root.newTaskPriority === "high"
                      ? Qt.rgba(0.937, 0.267, 0.267, 0.22)
                      : highMouse.containsMouse
                        ? Qt.rgba(root.fg.r, root.fg.g, root.fg.b, 0.08)
                        : "transparent"
                    border.width: 1
                    border.color: root.newTaskPriority === "high"
                      ? "#ef4444"
                      : Qt.rgba(root.fg.r, root.fg.g, root.fg.b, 0.15)
                    Behavior on color { ColorAnimation { duration: 150 } }

                    Row {
                      id: highPillRow
                      anchors.centerIn: parent
                      spacing: Style.space(4)
                      Text {
                        text: "󰌵"
                        color: "#ef4444"
                        font.family: root.ff
                        font.pixelSize: 11
                      }
                      Text {
                        text: "High"
                        color: root.newTaskPriority === "high" ? "#ef4444" : Qt.darker(root.fg, 1.4)
                        font.family: root.ff
                        font.pixelSize: Style.font.caption
                        font.bold: root.newTaskPriority === "high"
                      }
                    }
                    MouseArea {
                      id: highMouse
                      anchors.fill: parent
                      cursorShape: Qt.PointingHandCursor
                      hoverEnabled: true
                      onClicked: root.newTaskPriority = "high"
                    }
                  }

                  // Medium Chip
                  Rectangle {
                    anchors.verticalCenter: parent.verticalCenter
                    height: Style.space(22)
                    width: medPillRow.implicitWidth + Style.space(12)
                    radius: Style.space(11)
                    color: root.newTaskPriority === "medium"
                      ? Qt.rgba(0.961, 0.620, 0.043, 0.22)
                      : medMouse.containsMouse
                        ? Qt.rgba(root.fg.r, root.fg.g, root.fg.b, 0.08)
                        : "transparent"
                    border.width: 1
                    border.color: root.newTaskPriority === "medium"
                      ? "#f59e0b"
                      : Qt.rgba(root.fg.r, root.fg.g, root.fg.b, 0.15)
                    Behavior on color { ColorAnimation { duration: 150 } }

                    Row {
                      id: medPillRow
                      anchors.centerIn: parent
                      spacing: Style.space(4)
                      Text {
                        text: "󰚌"
                        color: "#f59e0b"
                        font.family: root.ff
                        font.pixelSize: 11
                      }
                      Text {
                        text: "Medium"
                        color: root.newTaskPriority === "medium" ? "#f59e0b" : Qt.darker(root.fg, 1.4)
                        font.family: root.ff
                        font.pixelSize: Style.font.caption
                        font.bold: root.newTaskPriority === "medium"
                      }
                    }
                    MouseArea {
                      id: medMouse
                      anchors.fill: parent
                      cursorShape: Qt.PointingHandCursor
                      hoverEnabled: true
                      onClicked: root.newTaskPriority = "medium"
                    }
                  }

                  // Low Chip
                  Rectangle {
                    anchors.verticalCenter: parent.verticalCenter
                    height: Style.space(22)
                    width: lowPillRow.implicitWidth + Style.space(12)
                    radius: Style.space(11)
                    color: root.newTaskPriority === "low"
                      ? Qt.rgba(0.231, 0.510, 0.965, 0.22)
                      : lowMouse.containsMouse
                        ? Qt.rgba(root.fg.r, root.fg.g, root.fg.b, 0.08)
                        : "transparent"
                    border.width: 1
                    border.color: root.newTaskPriority === "low"
                      ? "#3b82f6"
                      : Qt.rgba(root.fg.r, root.fg.g, root.fg.b, 0.15)
                    Behavior on color { ColorAnimation { duration: 150 } }

                    Row {
                      id: lowPillRow
                      anchors.centerIn: parent
                      spacing: Style.space(4)
                      Text {
                        text: "󰌑"
                        color: "#3b82f6"
                        font.family: root.ff
                        font.pixelSize: 11
                      }
                      Text {
                        text: "Low"
                        color: root.newTaskPriority === "low" ? "#3b82f6" : Qt.darker(root.fg, 1.4)
                        font.family: root.ff
                        font.pixelSize: Style.font.caption
                        font.bold: root.newTaskPriority === "low"
                      }
                    }
                    MouseArea {
                      id: lowMouse
                      anchors.fill: parent
                      cursorShape: Qt.PointingHandCursor
                      hoverEnabled: true
                      onClicked: root.newTaskPriority = "low"
                    }
                  }

                  Item {
                    width: Math.max(0, parent.width - (highPillRow.parent.width + medPillRow.parent.width + lowPillRow.parent.width + Style.space(64) + tipText.implicitWidth))
                    height: 1
                  }

                  Text {
                    id: tipText
                    anchors.verticalCenter: parent.verticalCenter
                    text: "!high · !med · !low"
                    color: Qt.darker(root.fg, 2.0)
                    font.family: root.ff
                    font.pixelSize: Style.font.caption * 0.85
                  }
                }
              }
            }

            PanelSeparator { foreground: root.fg }

            // ── Empty State ─────────────────────────────────────────────────
            Rectangle {
              visible: !root.svc || root.taskListModel.length === 0
              width: parent.width
              height: Style.space(120)
              radius: Style.cornerRadius * 1.3
              color: Qt.rgba(root.fg.r, root.fg.g, root.fg.b, 0.03)

              Column {
                anchors.centerIn: parent
                spacing: Style.space(6)
                Text {
                  anchors.horizontalCenter: parent.horizontalCenter
                  text: root.taskFilter === "done" ? "󰄲" : "󰗡"
                  color: Qt.darker(root.fg, 1.6)
                  font.family: root.ff
                  font.pixelSize: 38
                }
                Text {
                  anchors.horizontalCenter: parent.horizontalCenter
                  text: root.taskFilter === "done" ? "No completed tasks yet" : (root.svc && root.svc.tasks.length > 0 ? "No tasks matching filter" : "All caught up! 🎉")
                  color: root.fg
                  font.family: root.ff
                  font.pixelSize: Style.font.body
                  font.bold: true
                }
                Text {
                  anchors.horizontalCenter: parent.horizontalCenter
                  text: "Add tasks above to track sessions against your goals"
                  color: Qt.darker(root.fg, 1.5)
                  font.family: root.ff
                  font.pixelSize: Style.font.caption
                }
              }
            }

            // ── Scrollable Tasks List ───────────────────────────────────────
            Item {
              width: parent.width
              height: Math.min(Style.space(280), taskList.contentHeight)
              visible: root.svc && root.taskListModel.length > 0
              clip: true

              ListView {
                id: taskList
                anchors.fill: parent
                spacing: Style.space(6)
                model: root.taskListModel
                boundsBehavior: Flickable.StopAtBounds

                delegate: Rectangle {
                  id: taskRowRect
                  required property var modelData
                  required property int index

                  readonly property bool isActive: root.svc && String(root.svc.activeTaskId) === String(modelData.id)
                  readonly property bool isEditing: root.editingTaskId === String(modelData.id)

                  width: taskList.width
                  height: Style.space(52)
                  radius: Style.cornerRadius * 1.2
                  color: isActive
                    ? Qt.rgba(Color.accent.r, Color.accent.g, Color.accent.b, 0.12)
                    : itemMouse.containsMouse
                      ? Qt.rgba(root.fg.r, root.fg.g, root.fg.b, 0.08)
                      : modelData.done
                        ? Qt.rgba(root.fg.r, root.fg.g, root.fg.b, 0.02)
                        : Qt.rgba(root.fg.r, root.fg.g, root.fg.b, 0.05)
                  border.width: 1
                  border.color: isActive
                    ? Qt.rgba(Color.accent.r, Color.accent.g, Color.accent.b, 0.35)
                    : Qt.rgba(root.fg.r, root.fg.g, root.fg.b, 0.06)
                  Behavior on color { ColorAnimation { duration: 150 } }

                  MouseArea {
                    id: itemMouse
                    anchors.fill: parent
                    hoverEnabled: true
                    acceptedButtons: Qt.NoButton
                  }

                  Row {
                    anchors.fill: parent
                    anchors.leftMargin: Style.space(12)
                    anchors.rightMargin: Style.space(8)
                    spacing: Style.space(10)

                    // Toggle Checkbox
                    Rectangle {
                      width: Style.space(22); height: width
                      anchors.verticalCenter: parent.verticalCenter
                      radius: Style.space(6)
                      color: modelData.done ? Color.accent : "transparent"
                      border.width: 2
                      border.color: modelData.done ? Color.accent : Qt.darker(root.fg, 1.4)
                      Behavior on color { ColorAnimation { duration: 180 } }

                      Text {
                        anchors.centerIn: parent
                        text: "✓"
                        visible: modelData.done
                        color: Color.background
                        font.pixelSize: 11
                        font.bold: true
                      }
                      MouseArea {
                        anchors.fill: parent
                        cursorShape: Qt.PointingHandCursor
                        onClicked: if (root.svc) root.svc.toggleTask(modelData.id)
                      }
                    }

                    // Task Title or Inline Editor
                    Item {
                      width: parent.width - Style.space(160)
                      height: parent.height

                      // Normal View
                      Column {
                        visible: !taskRowRect.isEditing
                        anchors.verticalCenter: parent.verticalCenter
                        width: parent.width
                        spacing: 2

                        Text {
                          width: parent.width
                          text: modelData.title
                          color: modelData.done ? Qt.darker(root.fg, 1.7) : root.fg
                          font.family: root.ff
                          font.pixelSize: Style.font.body
                          font.strikeout: modelData.done
                          elide: Text.ElideRight
                        }

                        Row {
                          spacing: Style.space(6)

                          // Interactive Priority Badge (Click to cycle priority)
                          Rectangle {
                            anchors.verticalCenter: parent.verticalCenter
                            height: Style.space(16)
                            width: prioBadgeRow.implicitWidth + Style.space(8)
                            radius: Style.space(8)
                            color: {
                              var p = modelData.priority || "medium"
                              if (p === "high") return Qt.rgba(0.937, 0.267, 0.267, 0.18)
                              if (p === "low")  return Qt.rgba(0.231, 0.510, 0.965, 0.18)
                              return Qt.rgba(0.961, 0.620, 0.043, 0.18)
                            }
                            border.width: 1
                            border.color: Model.priorityColor(modelData.priority)

                            Row {
                              id: prioBadgeRow
                              anchors.centerIn: parent
                              spacing: Style.space(2)
                              Text {
                                text: Model.priorityIcon(modelData.priority)
                                color: Model.priorityColor(modelData.priority)
                                font.family: root.ff
                                font.pixelSize: 9
                              }
                              Text {
                                text: Model.priorityLabel(modelData.priority)
                                color: Model.priorityColor(modelData.priority)
                                font.family: root.ff
                                font.pixelSize: Style.font.caption * 0.85
                                font.bold: true
                              }
                            }

                            MouseArea {
                              anchors.fill: parent
                              cursorShape: Qt.PointingHandCursor
                              hoverEnabled: true
                              onClicked: {
                                if (root.svc) root.svc.cycleTaskPriority(modelData.id)
                              }
                            }
                          }

                          Text {
                            anchors.verticalCenter: parent.verticalCenter
                            text: "· 󰔛 " + (modelData.pomos || 0) + " pomos"
                            color: Color.accent
                            font.family: root.ff
                            font.pixelSize: Style.font.caption
                          }
                          Text {
                            visible: taskRowRect.isActive
                            anchors.verticalCenter: parent.verticalCenter
                            text: "· Active Focus"
                            color: Color.accent
                            font.family: root.ff
                            font.pixelSize: Style.font.caption
                            font.bold: true
                          }
                        }
                      }

                      MouseArea {
                        anchors.fill: parent
                        visible: !taskRowRect.isEditing
                        cursorShape: Qt.PointingHandCursor
                        onDoubleClicked: {
                          root.editingTaskId = String(modelData.id)
                          root.editingTaskTitle = modelData.title
                          root.editingTaskPriority = modelData.priority || "medium"
                        }
                      }

                      // Inline Editor View
                      Row {
                        visible: taskRowRect.isEditing
                        anchors.fill: parent
                        anchors.verticalCenter: parent.verticalCenter
                        spacing: Style.space(4)

                        TextInput {
                          id: editInput
                          width: parent.width - Style.space(96)
                          anchors.verticalCenter: parent.verticalCenter
                          text: root.editingTaskTitle
                          color: root.fg
                          font.family: root.ff
                          font.pixelSize: Style.font.body
                          clip: true
                          focus: taskRowRect.isEditing
                          onAccepted: {
                            if (root.svc) root.svc.editTask(modelData.id, text, root.editingTaskPriority)
                            root.editingTaskId = ""
                          }
                        }

                        Button {
                          text: Model.priorityLabel(root.editingTaskPriority)
                          width: Style.space(36); height: Style.space(26)
                          anchors.verticalCenter: parent.verticalCenter
                          foreground: Model.priorityColor(root.editingTaskPriority)
                          accent: Model.priorityColor(root.editingTaskPriority)
                          fontFamily: root.ff
                          fontSize: Style.font.caption * 0.85
                          tooltipText: "Click to cycle priority"
                          onClicked: {
                            root.editingTaskPriority = Model.nextPriority(root.editingTaskPriority)
                          }
                        }

                        Button {
                          text: "✓"
                          width: Style.space(26); height: Style.space(26)
                          anchors.verticalCenter: parent.verticalCenter
                          foreground: root.fg; accent: Color.accent; fontFamily: root.ff
                          onClicked: {
                            if (root.svc) root.svc.editTask(modelData.id, editInput.text, root.editingTaskPriority)
                            root.editingTaskId = ""
                          }
                        }

                        Button {
                          text: "✕"
                          width: Style.space(26); height: Style.space(26)
                          anchors.verticalCenter: parent.verticalCenter
                          foreground: Qt.darker(root.fg, 1.4); accent: Color.accent; fontFamily: root.ff
                          onClicked: root.editingTaskId = ""
                        }
                      }
                    }

                    // Focus Button
                    Button {
                      anchors.verticalCenter: parent.verticalCenter
                      text: taskRowRect.isActive ? "󰌵 Active" : "󱎫 Focus"
                      selected: taskRowRect.isActive
                      foreground: root.fg
                      accent: Color.accent
                      fontFamily: root.ff
                      fontSize: Style.font.caption
                      onClicked: {
                        if (root.svc) {
                          root.svc.setActiveTask(modelData.id)
                          root.activeTab = 0
                        }
                      }
                    }

                    // Delete Button
                    Button {
                      width: Style.space(28); height: Style.space(28)
                      anchors.verticalCenter: parent.verticalCenter
                      text: "󰆴"
                      foreground: Qt.darker(root.fg, 1.4)
                      accent: Color.accent
                      fontFamily: root.ff
                      fontSize: Style.font.caption
                      onClicked: if (root.svc) root.svc.removeTask(modelData.id)
                    }
                  }
                }
              }
            }
          }

          // ──────────────────────────────────────────────────────────────────
          // TAB 2: SETTINGS PAGE
          // ──────────────────────────────────────────────────────────────────
          Item {
            id: settingsPage
            width: parent.width
            implicitHeight: Math.min(Style.space(560), settingsInnerCol.implicitHeight)
            visible: root.activeTab === 2
            clip: true

            Flickable {
              anchors.fill: parent
              contentWidth: width
              contentHeight: settingsInnerCol.implicitHeight
              boundsBehavior: Flickable.StopAtBounds
              clip: true

              Column {
                id: settingsInnerCol
                width: parent.width
                spacing: Style.space(10)

                // ── Durations Card ──────────────────────────────────────────
                Rectangle {
                  width: parent.width
                  height: durationCol.implicitHeight + Style.space(22)
                  radius: Style.cornerRadius * 1.3
                  color: Qt.rgba(root.fg.r, root.fg.g, root.fg.b, 0.04)
                  border.width: 1
                  border.color: Qt.rgba(root.fg.r, root.fg.g, root.fg.b, 0.07)

                  Column {
                    id: durationCol
                    anchors.fill: parent
                    anchors.margins: Style.space(12)
                    spacing: Style.space(10)

                    PanelSectionHeader { text: "󱎫 Timer Durations"; foreground: root.fg; fontFamily: root.ff }

                    // Focus Duration
                    Column {
                      width: parent.width
                      spacing: Style.space(6)

                      Row {
                        width: parent.width
                        Text {
                          width: parent.width * 0.45
                          anchors.verticalCenter: parent.verticalCenter
                          text: "Focus length (min)"
                          color: root.fg
                          font.family: root.ff
                          font.pixelSize: Style.font.body
                        }

                        StepperRow {
                          value: root.svc ? root.svc.focusMinutes : 25
                          foreground: root.fg
                          fontFamily: root.ff
                          onStep: function(d) {
                            if (root.svc) root.svc.focusMinutes = Model.clampInt(root.svc.focusMinutes + d, 25, 1, 1440)
                          }
                          onValueCommitted: function(v) {
                            if (root.svc) root.svc.focusMinutes = Model.clampInt(v, 25, 1, 1440)
                          }
                        }
                      }

                      Row {
                        width: parent.width
                        spacing: Style.space(5)

                        Repeater {
                          model: [15, 25, 45, 60, 90, 180]
                          delegate: Button {
                            required property int modelData
                            width: (parent.width - Style.space(5) * 5) / 6
                            text: modelData >= 60 ? (modelData / 60) + "h" : modelData + "m"
                            selected: root.svc && root.svc.focusMinutes === modelData
                            foreground: root.fg
                            accent: Color.accent
                            fontFamily: root.ff
                            fontSize: Style.font.caption
                            onClicked: if (root.svc) root.svc.focusMinutes = modelData
                          }
                        }
                      }
                    }

                    PanelSeparator { foreground: root.fg }

                    // Break Duration
                    Column {
                      width: parent.width
                      spacing: Style.space(6)

                      Row {
                        width: parent.width
                        Text {
                          width: parent.width * 0.45
                          anchors.verticalCenter: parent.verticalCenter
                          text: "Break length (min)"
                          color: root.fg
                          font.family: root.ff
                          font.pixelSize: Style.font.body
                        }

                        StepperRow {
                          value: root.svc ? root.svc.breakMinutes : 5
                          foreground: root.fg
                          fontFamily: root.ff
                          onStep: function(d) {
                            if (root.svc) root.svc.breakMinutes = Model.clampInt(root.svc.breakMinutes + d, 5, 1, 1440)
                          }
                          onValueCommitted: function(v) {
                            if (root.svc) root.svc.breakMinutes = Model.clampInt(v, 5, 1, 1440)
                          }
                        }
                      }

                      Row {
                        width: parent.width
                        spacing: Style.space(5)

                        Repeater {
                          model: [3, 5, 10, 15, 20, 30]
                          delegate: Button {
                            required property int modelData
                            width: (parent.width - Style.space(5) * 5) / 6
                            text: modelData + "m"
                            selected: root.svc && root.svc.breakMinutes === modelData
                            foreground: root.fg
                            accent: Color.accent
                            fontFamily: root.ff
                            fontSize: Style.font.caption
                            onClicked: if (root.svc) root.svc.breakMinutes = modelData
                          }
                        }
                      }
                    }
                  }
                }

                // ── Automation Card ─────────────────────────────────────────
                Rectangle {
                  width: parent.width
                  height: autoCol.implicitHeight + Style.space(22)
                  radius: Style.cornerRadius * 1.3
                  color: Qt.rgba(root.fg.r, root.fg.g, root.fg.b, 0.04)
                  border.width: 1
                  border.color: Qt.rgba(root.fg.r, root.fg.g, root.fg.b, 0.07)

                  Column {
                    id: autoCol
                    anchors.fill: parent
                    anchors.margins: Style.space(12)
                    spacing: Style.space(8)

                    PanelSectionHeader { text: "󰔎 Automation"; foreground: root.fg; fontFamily: root.ff }

                    Toggle {
                      width: parent.width
                      label: "Auto-start break"
                      description: "Start break timer automatically after focus completes"
                      checked: root.svc ? root.svc.autoStartBreak : true
                      foreground: root.fg
                      accent: Color.accent
                      fontFamily: root.ff
                      onClicked: if (root.svc) root.svc.autoStartBreak = !root.svc.autoStartBreak
                    }

                    Toggle {
                      width: parent.width
                      label: "Auto-start focus"
                      description: "Start next focus session automatically after break ends"
                      checked: root.svc ? root.svc.autoStartFocus : false
                      foreground: root.fg
                      accent: Color.accent
                      fontFamily: root.ff
                      onClicked: if (root.svc) root.svc.autoStartFocus = !root.svc.autoStartFocus
                    }
                  }
                }

                // ── Completion Alerts Card ──────────────────────────────────
                Rectangle {
                  width: parent.width
                  height: alertCol.implicitHeight + Style.space(22)
                  radius: Style.cornerRadius * 1.3
                  color: Qt.rgba(root.fg.r, root.fg.g, root.fg.b, 0.04)
                  border.width: 1
                  border.color: Qt.rgba(root.fg.r, root.fg.g, root.fg.b, 0.07)

                  Column {
                    id: alertCol
                    anchors.fill: parent
                    anchors.margins: Style.space(12)
                    spacing: Style.space(8)

                    PanelSectionHeader { text: "󰂚 Completion Alerts"; foreground: root.fg; fontFamily: root.ff }

                    Row {
                      width: parent.width
                      spacing: Style.space(8)

                      Button {
                        width: (parent.width - Style.space(8)) / 2
                        text: "󰂚 Notification"
                        selected: root.svc ? root.svc.reminderMode === "notification" : true
                        fontFamily: root.ff; foreground: root.fg; accent: Color.accent
                        onClicked: if (root.svc) root.svc.reminderMode = "notification"
                      }

                      Button {
                        width: (parent.width - Style.space(8)) / 2
                        text: "󰍹 Full Overlay"
                        selected: root.svc ? root.svc.reminderMode === "overlay" : false
                        fontFamily: root.ff; foreground: root.fg; accent: Color.accent
                        onClicked: if (root.svc) root.svc.reminderMode = "overlay"
                      }
                    }

                    Toggle {
                      width: parent.width
                      label: "Timer completion sound"
                      description: "Play chime when focus or break timer finishes"
                      checked: root.svc ? root.svc.soundAlert : true
                      foreground: root.fg
                      accent: Color.accent
                      fontFamily: root.ff
                      onClicked: if (root.svc) root.svc.soundAlert = !root.svc.soundAlert
                    }

                    Toggle {
                      width: parent.width
                      label: "Task completion sound"
                      description: "Play pleasant chime when a task is marked done"
                      checked: root.svc ? root.svc.taskSoundAlert : true
                      foreground: root.fg
                      accent: Color.accent
                      fontFamily: root.ff
                      onClicked: if (root.svc) root.svc.taskSoundAlert = !root.svc.taskSoundAlert
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
