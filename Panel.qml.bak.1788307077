import QtQuick
import QtQuick.Controls
import Quickshell
import qs.Commons
import qs.Ui
import "Model.js" as Model

// Focus Flow Panel UI — 3 Tab Interface: Focus, Tasks, Settings.
Panel {
  id: root
  moduleName: "zakarch.focusflow"
  ipcTarget: "zakarch.focusflow.panel"
  manageIpc: false

  property var anchorItem: null
  property var hostWidget: null
  readonly property var barIdentity: hostWidget || root

  readonly property var svc: bar && bar.shell ? bar.shell.serviceFor("zakarch.focusflow") : null

  readonly property color fg:  bar ? bar.foreground : Color.foreground
  readonly property string ff: bar ? bar.fontFamily : Style.font.family

  // ── Active tab (0: Focus, 1: Tasks, 2: Settings) ───────────────────────────
  property int activeTab: 0

  // ── Pomodoro computations ──────────────────────────────────────────────────
  readonly property string heroTime: svc
    ? (svc.phase === "idle" ? Model.formatRemaining(svc.focusMinutes * 60000) : svc.displayTime)
    : "25:00"

  readonly property string heroLabel: svc
    ? (svc.phase === "focus" ? "FOCUS" : (svc.phase === "break" ? "BREAK" : "IDLE"))
    : "IDLE"

  readonly property string statusLine: !svc ? ""
    : svc.phase === "idle" ? "Ready to flow"
    : svc.running ? "Timer running" : "Paused"

  readonly property string primaryLabel: !svc ? "󰐊 Start focus"
    : svc.phase === "idle" ? "󰐊 Start focus"
    : svc.running ? "󰏤 Pause" : "󰐊 Resume"

  readonly property real progress: svc && svc.totalSeconds > 0
    ? Math.min(1, svc.elapsedSeconds / svc.totalSeconds) : 0

  function primaryAction() {
    if (!svc) return
    if (svc.phase === "idle") svc.startFocus()
    else if (svc.running) svc.pause()
    else svc.resume()
  }

  function switchPanel(direction) {
    if (root.bar && typeof root.bar.switchPanelFrom === "function")
      return root.bar.switchPanelFrom(root.barIdentity, direction)
    return false
  }

  KeyboardPanel {
    id: panel
    anchorItem: root.anchorItem
    owner: root.barIdentity
    bar: root.bar
    open: root.opened
    centerOnBar: true
    focusTarget: keyCatcher
    contentWidth: panel.fittedContentWidth(Style.space(400))
    contentHeight: panel.fittedContentHeight(mainCol.implicitHeight)

    PanelKeyCatcher {
      id: keyCatcher
      anchors.fill: parent
      onCloseRequested: root.close()
      onTabRequested: function(d) { root.switchPanel(d) }
      onTextKey: function(t) {
        // Ignore single-key panel shortcuts when a text field has active focus!
        if (!keyCatcher.activeFocus) return

        if (t === "1") root.activeTab = 0
        else if (t === "2") root.activeTab = 1
        else if (t === "3") root.activeTab = 2
        else if ((t === "s" || t === "S") && root.activeTab === 0) {
          if (root.svc && root.svc.phase === "idle") root.svc.startFocus()
        } else if ((t === "p" || t === "P") && root.activeTab === 0) {
          if (root.svc) { if (root.svc.running) root.svc.pause(); else root.svc.resume() }
        } else if ((t === "r" || t === "R") && root.activeTab === 0) {
          if (root.svc) root.svc.reset()
        }
      }

      Column {
        id: mainCol
        width: parent.width
        spacing: Style.space(10)

        // ════════════ SEGMENTED TAB BAR ═════════════════════════════════════
        Rectangle {
          width: parent.width
          height: Style.space(42)
          radius: Style.cornerRadius
          color: Qt.rgba(root.fg.r, root.fg.g, root.fg.b, 0.06)
          border.width: 1
          border.color: Qt.rgba(root.fg.r, root.fg.g, root.fg.b, 0.10)

          Row {
            anchors.fill: parent
            anchors.margins: Style.space(4)
            spacing: Style.space(4)

            Repeater {
              model: [
                { icon: "󱎫", label: "Focus" },
                { icon: "󰏫", label: "Tasks" },
                { icon: "󰒓", label: "Settings" }
              ]
              delegate: Rectangle {
                required property int index
                required property var modelData
                width: (parent.width - Style.space(8)) / 3
                height: parent.height
                radius: Math.max(2, Style.cornerRadius - 2)
                color: root.activeTab === index
                  ? Qt.rgba(Color.accent.r, Color.accent.g, Color.accent.b, 0.22)
                  : "transparent"
                border.width: root.activeTab === index ? 1 : 0
                border.color: Color.accent

                Row {
                  anchors.centerIn: parent
                  spacing: Style.space(6)
                  Text {
                    text: modelData.icon
                    color: root.activeTab === index ? Color.accent : Qt.darker(root.fg, 1.5)
                    font.family: root.ff
                    font.pixelSize: Style.font.body
                  }
                  Text {
                    text: modelData.label
                    color: root.activeTab === index ? root.fg : Qt.darker(root.fg, 1.4)
                    font.family: root.ff
                    font.pixelSize: Style.font.body
                    font.bold: root.activeTab === index
                  }
                }

                MouseArea {
                  anchors.fill: parent
                  onClicked: root.activeTab = index
                }
              }
            }
          }
        }

        // ════════════ TAB PAGES CONTAINER ═══════════════════════════════════
        Item {
          width: parent.width
          implicitHeight: root.activeTab === 0 ? focusPage.implicitHeight
                        : root.activeTab === 1 ? tasksPage.implicitHeight
                        : settingsPage.implicitHeight

          // ──────────────────────────────────────────────────────────────────
          // TAB 0: FOCUS PAGE
          // ──────────────────────────────────────────────────────────────────
          Column {
            id: focusPage
            width: parent.width
            spacing: Style.space(10)
            visible: root.activeTab === 0

            // Active Task Card / Banner
            Rectangle {
              width: parent.width
              height: Style.space(56)
              radius: Style.cornerRadius * 1.5
              color: root.svc && root.svc.activeTask
                ? Qt.rgba(Color.accent.r, Color.accent.g, Color.accent.b, 0.15)
                : Qt.rgba(root.fg.r, root.fg.g, root.fg.b, 0.04)
              border.width: 1
              border.color: root.svc && root.svc.activeTask
                ? Qt.rgba(Color.accent.r, Color.accent.g, Color.accent.b, 0.4)
                : Qt.rgba(root.fg.r, root.fg.g, root.fg.b, 0.1)
              
              Behavior on color { ColorAnimation { duration: 250 } }

              Row {
                anchors.fill: parent
                anchors.leftMargin: Style.space(16)
                anchors.rightMargin: Style.space(12)
                spacing: Style.space(12)

                // Task Icon container
                Rectangle {
                  anchors.verticalCenter: parent.verticalCenter
                  width: Style.space(34)
                  height: Style.space(34)
                  radius: width / 2
                  color: root.svc && root.svc.activeTask
                    ? Qt.rgba(Color.accent.r, Color.accent.g, Color.accent.b, 0.25)
                    : Qt.rgba(root.fg.r, root.fg.g, root.fg.b, 0.08)
                  
                  Text {
                    anchors.centerIn: parent
                    text: root.svc && root.svc.activeTask ? "󰌵" : "󰏫"
                    color: root.svc && root.svc.activeTask ? Color.accent : Qt.darker(root.fg, 1.2)
                    font.family: root.ff
                    font.pixelSize: Style.font.body
                  }
                }

                Column {
                  width: parent.width - Style.space(136)
                  anchors.verticalCenter: parent.verticalCenter
                  spacing: 2

                  Text {
                    width: parent.width
                    text: root.svc && root.svc.activeTask ? root.svc.activeTask.title : "No task linked to timer"
                    color: root.fg
                    font.family: root.ff
                    font.pixelSize: Style.font.body
                    font.bold: true
                    elide: Text.ElideRight
                  }

                  Text {
                    text: root.svc && root.svc.activeTask
                      ? "󰔛 " + (root.svc.activeTask.pomos || 0) + " pomodoros completed on this task"
                      : "Link a task from the Tasks tab to track focus"
                    color: Qt.darker(root.fg, 1.4)
                    font.family: root.ff
                    font.pixelSize: Style.font.caption
                  }
                }

                // Action button (Unlink if active, or Select Task button)
                Button {
                  anchors.verticalCenter: parent.verticalCenter
                  text: root.svc && root.svc.activeTask ? "Unlink" : "Select"
                  foreground: root.fg
                  accent: Color.accent
                  fontFamily: root.ff
                  onClicked: {
                    if (root.svc && root.svc.activeTask) root.svc.setActiveTask("")
                    else root.activeTab = 1
                  }
                }
              }
            }

            // 🌟 Creative Hero Timer Container Card 🌟
            Rectangle {
              id: heroCard
              width: parent.width
              height: Style.space(220)
              radius: Style.cornerRadius * 3
              color: root.svc && root.svc.phase === "focus" && root.svc.running
                ? Qt.rgba(Color.accent.r, Color.accent.g, Color.accent.b, 0.05)
                : root.svc && root.svc.phase === "break" && root.svc.running
                  ? Qt.rgba(0.13, 0.77, 0.36, 0.05)
                  : Qt.rgba(root.fg.r, root.fg.g, root.fg.b, 0.03)
              border.width: 1
              border.color: root.svc && root.svc.phase === "focus" && root.svc.running
                ? Qt.rgba(Color.accent.r, Color.accent.g, Color.accent.b, 0.35)
                : root.svc && root.svc.phase === "break" && root.svc.running
                  ? Qt.rgba(0.13, 0.77, 0.36, 0.35)
                  : Qt.rgba(root.fg.r, root.fg.g, root.fg.b, 0.1)

              Behavior on color { ColorAnimation { duration: 400 } }
              Behavior on border.color { ColorAnimation { duration: 400 } }

              // Dynamic animated glow behind the timer
              Rectangle {
                anchors.centerIn: parent
                width: parent.width * 0.75
                height: parent.height * 0.75
                radius: width / 2
                color: root.svc && root.svc.phase === "break" ? "#22c55e" : Color.accent
                opacity: root.svc && root.svc.running ? 0.08 : 0.0
                Behavior on opacity { NumberAnimation { duration: 1000 } }
                
                SequentialAnimation on scale {
                  loops: Animation.Infinite
                  running: root.svc && root.svc.running
                  NumberAnimation { from: 0.95; to: 1.05; duration: 2500; easing.type: Easing.InOutSine }
                  NumberAnimation { from: 1.05; to: 0.95; duration: 2500; easing.type: Easing.InOutSine }
                }
              }

              Column {
                anchors.centerIn: parent
                spacing: Style.space(12)

                // Phase Badge Pill with subtle glow
                Rectangle {
                  anchors.horizontalCenter: parent.horizontalCenter
                  width: phaseText.implicitWidth + Style.space(32)
                  height: Style.space(28)
                  radius: height / 2
                  color: root.svc && root.svc.phase === "focus"
                    ? Qt.rgba(Color.accent.r, Color.accent.g, Color.accent.b, 0.15)
                    : root.svc && root.svc.phase === "break"
                      ? Qt.rgba(0.13, 0.77, 0.36, 0.15)
                      : Qt.rgba(root.fg.r, root.fg.g, root.fg.b, 0.06)
                  border.width: 1
                  border.color: root.svc && root.svc.phase === "focus"
                    ? Qt.rgba(Color.accent.r, Color.accent.g, Color.accent.b, 0.4)
                    : root.svc && root.svc.phase === "break"
                      ? Qt.rgba(0.13, 0.77, 0.36, 0.4)
                      : Qt.rgba(root.fg.r, root.fg.g, root.fg.b, 0.12)
                  
                  Text {
                    id: phaseText
                    anchors.centerIn: parent
                    text: root.svc && root.svc.phase === "focus" ? "󱎫 DEEP FOCUS" : root.svc && root.svc.phase === "break" ? "󰅶 BREAK TIME" : "󰒲 READY TO FLOW"
                    color: root.svc && root.svc.phase === "focus"
                      ? Color.accent
                      : root.svc && root.svc.phase === "break"
                        ? "#4ade80"
                        : root.fg
                    font.family: root.ff
                    font.pixelSize: Style.font.caption
                    font.bold: true
                    font.letterSpacing: 2.0
                  }
                }

                // Big Digital Countdown with drop shadow glow
                Item {
                  anchors.horizontalCenter: parent.horizontalCenter
                  width: heroText.implicitWidth
                  height: heroText.implicitHeight
                  
                  Text {
                    anchors.centerIn: parent
                    text: root.heroTime
                    color: root.svc && root.svc.phase === "break" ? "#22c55e" : Color.accent
                    font.family: root.ff
                    font.pixelSize: 84
                    font.bold: true
                    opacity: root.svc && root.svc.running ? 0.25 : 0.0
                    scale: 1.02
                    Behavior on opacity { NumberAnimation { duration: 500 } }
                  }
                  
                  Text {
                    id: heroText
                    anchors.centerIn: parent
                    text: root.heroTime
                    color: root.fg
                    font.family: root.ff
                    font.pixelSize: 84
                    font.bold: true
                    font.letterSpacing: 1.5
                  }
                }

                // Status line
                Text {
                  anchors.horizontalCenter: parent.horizontalCenter
                  text: root.statusLine
                  color: Qt.darker(root.fg, 1.4)
                  font.family: root.ff
                  font.pixelSize: Style.font.body
                  font.italic: true
                }

                // Enhanced Progress Bar
                Item {
                  width: focusPage.width - Style.space(60)
                  height: Style.space(12)
                  anchors.horizontalCenter: parent.horizontalCenter

                  // Background track
                  Rectangle {
                    anchors.fill: parent
                    radius: height / 2
                    color: Qt.rgba(root.fg.r, root.fg.g, root.fg.b, 0.08)
                    border.width: 1
                    border.color: Qt.rgba(0, 0, 0, 0.2)
                  }
                  
                  // Fill
                  Rectangle {
                    id: progressFill
                    width: Math.max(height, Math.round(parent.width * root.progress))
                    height: parent.height
                    radius: parent.radius
                    color: root.svc && root.svc.phase === "break" ? "#22c55e" : Color.accent
                    
                    Behavior on width { NumberAnimation { duration: 500; easing.type: Easing.OutQuint } }

                    // Highlight for 3D feel
                    Rectangle {
                      anchors.top: parent.top
                      anchors.left: parent.left
                      anchors.right: parent.right
                      height: parent.height / 2
                      radius: parent.radius
                      color: "#ffffff"
                      opacity: 0.2
                    }

                    // Glowing dot at the end
                    Rectangle {
                      anchors.right: parent.right
                      anchors.verticalCenter: parent.verticalCenter
                      anchors.rightMargin: Style.space(2)
                      width: Style.space(8)
                      height: Style.space(8)
                      radius: width / 2
                      color: "#ffffff"
                      visible: root.svc && root.svc.running
                      
                      Rectangle {
                        anchors.centerIn: parent
                        width: parent.width * 3
                        height: parent.height * 3
                        radius: width / 2
                        color: "#ffffff"
                        opacity: 0.4
                        
                        SequentialAnimation on scale {
                          loops: Animation.Infinite
                          running: root.svc && root.svc.running
                          NumberAnimation { from: 0.6; to: 1.4; duration: 1000; easing.type: Easing.OutQuad }
                          NumberAnimation { from: 1.4; to: 0.6; duration: 1000; easing.type: Easing.InQuad }
                        }
                      }
                    }
                  }
                }
              }
            }

            // Controls Action Row
            Row {
              width: parent.width
              spacing: Style.space(8)

              Button {
                id: primaryBtn
                width: (parent.width - Style.space(16)) * 0.50
                text: root.primaryLabel
                fontFamily: root.ff
                foreground: root.fg
                accent: Color.accent
                onClicked: root.primaryAction()
              }

              Button {
                width: (parent.width - Style.space(16)) * 0.25
                text: "󰅶 Break"
                fontFamily: root.ff
                foreground: root.fg
                accent: Color.accent
                onClicked: if (root.svc && root.svc.phase !== "break") root.svc.startBreak()
              }

              Button {
                width: (parent.width - Style.space(16)) * 0.25
                text: "󰜉 Reset"
                fontFamily: root.ff
                foreground: root.fg
                accent: Color.accent
                onClicked: if (root.svc && root.svc.phase !== "idle") root.svc.reset()
              }
            }

            PanelSeparator { foreground: root.fg }

            // Stats Grid Cards
            Row {
              width: parent.width
              spacing: Style.space(8)

              Repeater {
                model: [
                  { label: "Today",  value: root.svc ? root.svc.countToday : 0, icon: "󰔛" },
                  { label: "Week",   value: root.svc ? root.svc.countWeek  : 0, icon: "󰨲" },
                  { label: "Month",  value: root.svc ? root.svc.countMonth : 0, icon: "󰸗" }
                ]

                Rectangle {
                  required property var modelData
                  width: (focusPage.width - Style.space(16)) / 3
                  height: Style.space(56)
                  radius: Style.cornerRadius
                  color: Qt.rgba(root.fg.r, root.fg.g, root.fg.b, 0.04)
                  border.width: 1
                  border.color: Qt.rgba(root.fg.r, root.fg.g, root.fg.b, 0.08)

                  Column {
                    anchors.centerIn: parent
                    spacing: 1

                    Row {
                      anchors.horizontalCenter: parent.horizontalCenter
                      spacing: Style.space(4)
                      Text {
                        text: modelData.icon
                        color: Color.accent
                        font.family: root.ff
                        font.pixelSize: Style.font.body
                      }
                      Text {
                        text: String(modelData.value)
                        color: root.fg
                        font.family: root.ff
                        font.pixelSize: Style.font.title
                        font.bold: true
                      }
                    }

                    Text {
                      anchors.horizontalCenter: parent.horizontalCenter
                      text: modelData.label
                      color: Qt.darker(root.fg, 1.6)
                      font.family: root.ff
                      font.pixelSize: Style.font.caption
                    }
                  }
                }
              }
            }
          }

          // ──────────────────────────────────────────────────────────────────
          // TAB 1: TASKS PAGE
          // ──────────────────────────────────────────────────────────────────
          Column {
            id: tasksPage
            width: parent.width
            spacing: Style.space(10)
            visible: root.activeTab === 1

            // Tasks Header & Actions
            Row {
              width: parent.width

              Column {
                width: parent.width - clearBtn.width - Style.space(10)
                Text {
                  text: "Task Management"
                  color: root.fg; font.family: root.ff
                  font.pixelSize: Style.font.heading; font.bold: true
                }
                Text {
                  text: root.svc
                    ? "󰄯 " + root.svc.openCount + " open tasks · " + root.svc.tasks.length + " total"
                    : "Task list"
                  color: Qt.darker(root.fg, 1.5)
                  font.family: root.ff; font.pixelSize: Style.font.caption
                }
              }

              Button {
                id: clearBtn
                visible: root.svc && root.svc.tasks.some(function(t) { return t.done })
                text: "󰆴 Clear Done"
                foreground: Qt.darker(root.fg, 1.4)
                accent: Color.accent
                fontFamily: root.ff
                onClicked: if (root.svc) root.svc.clearCompletedTasks()
              }
            }

            // Task Input Box Row
            Row {
              width: parent.width
              spacing: Style.space(8)

              Rectangle {
                width: parent.width - Style.space(52)
                height: Style.space(42)
                radius: Style.cornerRadius
                color: Qt.rgba(root.fg.r, root.fg.g, root.fg.b, 0.06)
                border.width: 1
                border.color: taskInput.activeFocus
                  ? Color.accent
                  : Qt.rgba(root.fg.r, root.fg.g, root.fg.b, 0.16)

                Row {
                  anchors.fill: parent
                  anchors.leftMargin: Style.space(12)
                  anchors.rightMargin: Style.space(8)
                  spacing: Style.space(8)

                  Text {
                    anchors.verticalCenter: parent.verticalCenter
                    text: "󰗡"
                    color: taskInput.activeFocus ? Color.accent : Qt.darker(root.fg, 1.6)
                    font.family: root.ff
                    font.pixelSize: Style.font.body
                  }

                  TextInput {
                    id: taskInput
                    width: parent.width - Style.space(24)
                    anchors.verticalCenter: parent.verticalCenter
                    color: root.fg
                    font.family: root.ff
                    font.pixelSize: Style.font.body
                    clip: true
                    focus: root.activeTab === 1
                    onAccepted: {
                      if (root.svc && root.svc.addTask(text)) text = ""
                    }

                    Text {
                      visible: !parent.text
                      anchors.verticalCenter: parent.verticalCenter
                      text: "Add a new task..."
                      color: Qt.darker(root.fg, 1.7)
                      font: parent.font
                    }
                  }
                }
              }

              Button {
                text: "󰐕 Add"
                width: Style.space(44)
                height: Style.space(42)
                foreground: root.fg
                accent: Color.accent
                fontFamily: root.ff
                onClicked: {
                  if (root.svc && root.svc.addTask(taskInput.text)) taskInput.text = ""
                }
              }
            }

            PanelSeparator { foreground: root.fg }

            // Empty State Graphic
            Rectangle {
              visible: !root.svc || root.svc.tasks.length === 0
              width: parent.width
              height: Style.space(120)
              radius: Style.cornerRadius
              color: Qt.rgba(root.fg.r, root.fg.g, root.fg.b, 0.03)

              Column {
                anchors.centerIn: parent
                spacing: Style.space(6)
                Text {
                  anchors.horizontalCenter: parent.horizontalCenter
                  text: "󰗡"
                  color: Qt.darker(root.fg, 1.7)
                  font.family: root.ff
                  font.pixelSize: 42
                }
                Text {
                  anchors.horizontalCenter: parent.horizontalCenter
                  text: "All tasks completed!"
                  color: root.fg
                  font.family: root.ff
                  font.pixelSize: Style.font.body
                  font.bold: true
                }
                Text {
                  anchors.horizontalCenter: parent.horizontalCenter
                  text: "Add a task above to start tracking your focus"
                  color: Qt.darker(root.fg, 1.6)
                  font.family: root.ff
                  font.pixelSize: Style.font.caption
                }
              }
            }

            // Task Items List
            Repeater {
              model: root.svc ? root.svc.tasks : []
              delegate: Rectangle {
                required property var modelData
                readonly property bool isActive: root.svc && root.svc.activeTaskId === String(modelData.id)

                width: tasksPage.width
                height: Style.space(48)
                radius: Style.cornerRadius
                color: isActive
                  ? Qt.rgba(Color.accent.r, Color.accent.g, Color.accent.b, 0.16)
                  : modelData.done
                    ? Qt.rgba(root.fg.r, root.fg.g, root.fg.b, 0.03)
                    : Qt.rgba(root.fg.r, root.fg.g, root.fg.b, 0.07)
                border.width: 1
                border.color: isActive
                  ? Qt.rgba(Color.accent.r, Color.accent.g, Color.accent.b, 0.40)
                  : Qt.rgba(root.fg.r, root.fg.g, root.fg.b, 0.08)

                Row {
                  anchors.fill: parent
                  anchors.leftMargin: Style.space(10)
                  anchors.rightMargin: Style.space(8)
                  spacing: Style.space(10)

                  // Toggle Checkbox
                  Rectangle {
                    width: Style.space(24); height: width
                    anchors.verticalCenter: parent.verticalCenter
                    radius: width / 2
                    color: modelData.done ? Color.accent : "transparent"
                    border.width: 2
                    border.color: modelData.done ? Color.accent : Qt.darker(root.fg, 1.4)

                    Text {
                      anchors.centerIn: parent
                      text: "✓"
                      visible: modelData.done
                      color: Color.background
                      font.bold: true
                    }
                    MouseArea {
                      anchors.fill: parent
                      onClicked: root.svc.toggleTask(modelData.id)
                    }
                  }

                  // Title + Pomo Badge
                  Column {
                    width: parent.width - Style.space(160)
                    anchors.verticalCenter: parent.verticalCenter
                    spacing: 1

                    Text {
                      width: parent.width
                      text: modelData.title
                      color: modelData.done ? Qt.darker(root.fg, 1.8) : root.fg
                      font.family: root.ff
                      font.pixelSize: Style.font.body
                      font.strikeout: modelData.done
                      elide: Text.ElideRight
                    }

                    Row {
                      spacing: Style.space(6)
                      visible: (modelData.pomos || 0) > 0 || isActive

                      Text {
                        visible: (modelData.pomos || 0) > 0
                        text: "󰔛 " + (modelData.pomos || 0) + " pomos"
                        color: Color.accent
                        font.family: root.ff
                        font.pixelSize: Style.font.caption
                      }

                      Text {
                        visible: isActive
                        text: "· Active in Timer"
                        color: Color.accent
                        font.family: root.ff
                        font.pixelSize: Style.font.caption
                        font.bold: true
                      }
                    }
                  }

                  // Link to Timer Button
                  Button {
                    anchors.verticalCenter: parent.verticalCenter
                    text: isActive ? "󰌵 Active" : "󱎫 Link"
                    selected: isActive
                    foreground: root.fg
                    accent: Color.accent
                    fontFamily: root.ff
                    onClicked: root.svc.setActiveTask(modelData.id)
                  }

                  // Delete Task Button
                  Button {
                    width: Style.space(30); height: Style.space(30)
                    anchors.verticalCenter: parent.verticalCenter
                    text: "󰆴"
                    foreground: Qt.darker(root.fg, 1.4)
                    accent: Color.accent
                    fontFamily: root.ff
                    onClicked: root.svc.removeTask(modelData.id)
                  }
                }
              }
            }
          }

          // ──────────────────────────────────────────────────────────────────
          // TAB 2: SETTINGS PAGE
          // ──────────────────────────────────────────────────────────────────
          Column {
            id: settingsPage
            width: parent.width
            spacing: Style.space(12)
            visible: root.activeTab === 2

            // Timer Durations Section Card
            Rectangle {
              width: parent.width
              height: timerSettingsCol.implicitHeight + Style.space(24)
              radius: Style.cornerRadius
              color: Qt.rgba(root.fg.r, root.fg.g, root.fg.b, 0.04)
              border.width: 1
              border.color: Qt.rgba(root.fg.r, root.fg.g, root.fg.b, 0.08)

              Column {
                id: timerSettingsCol
                anchors.fill: parent
                anchors.margins: Style.space(12)
                spacing: Style.space(12)

                PanelSectionHeader { text: "󱎫 Duration Config"; foreground: root.fg; fontFamily: root.ff }

                // Focus Duration Row + Presets
                Column {
                  width: parent.width
                  spacing: Style.space(6)

                  Row {
                    width: parent.width
                    spacing: Style.space(8)

                    Text {
                      width: parent.width * 0.48
                      anchors.verticalCenter: parent.verticalCenter
                      text: "Focus duration (min)"
                      color: root.fg
                      font.family: root.ff
                      font.pixelSize: Style.font.body
                    }

                    StepperRow {
                      value: root.svc ? root.svc.focusMinutes : 25
                      foreground: root.fg
                      fontFamily: root.ff
                      onStep: function(d) {
                        if (root.svc) root.svc.focusMinutes = Model.clampInt(root.svc.focusMinutes + d, 25, 1, 1440)
                      }
                      onValueCommitted: function(v) {
                        if (root.svc) root.svc.focusMinutes = Model.clampInt(v, 25, 1, 1440)
                      }
                    }
                  }

                  // Quick presets row (6 options)
                  Row {
                    id: focusPresetsRow
                    width: parent.width
                    spacing: Style.space(6)

                    Text {
                      id: focusPresetsLabel
                      width: parent.width * 0.20
                      anchors.verticalCenter: parent.verticalCenter
                      text: "Presets:"
                      color: Qt.darker(root.fg, 1.6)
                      font.family: root.ff
                      font.pixelSize: Style.font.caption
                    }

                    Repeater {
                      model: [15, 25, 30, 45, 60, 120]
                      delegate: Button {
                        required property int modelData
                        width: (focusPresetsRow.width - focusPresetsLabel.width - Style.space(6) * 6) / 6
                        text: modelData + "m"
                        selected: root.svc && root.svc.focusMinutes === modelData
                        foreground: root.fg
                        accent: Color.accent
                        fontFamily: root.ff
                        onClicked: if (root.svc) root.svc.focusMinutes = modelData
                      }
                    }
                  }
                }

                PanelSeparator { foreground: root.fg }

                // Break Duration Row + Presets
                Column {
                  width: parent.width
                  spacing: Style.space(6)

                  Row {
                    width: parent.width
                    spacing: Style.space(8)

                    Text {
                      width: parent.width * 0.48
                      anchors.verticalCenter: parent.verticalCenter
                      text: "Break duration (min)"
                      color: root.fg
                      font.family: root.ff
                      font.pixelSize: Style.font.body
                    }

                    StepperRow {
                      value: root.svc ? root.svc.breakMinutes : 5
                      foreground: root.fg
                      fontFamily: root.ff
                      onStep: function(d) {
                        if (root.svc) root.svc.breakMinutes = Model.clampInt(root.svc.breakMinutes + d, 5, 1, 1440)
                      }
                      onValueCommitted: function(v) {
                        if (root.svc) root.svc.breakMinutes = Model.clampInt(v, 5, 1, 1440)
                      }
                    }
                  }

                  // Quick presets row (6 options)
                  Row {
                    id: breakPresetsRow
                    width: parent.width
                    spacing: Style.space(6)

                    Text {
                      id: breakPresetsLabel
                      width: parent.width * 0.20
                      anchors.verticalCenter: parent.verticalCenter
                      text: "Presets:"
                      color: Qt.darker(root.fg, 1.6)
                      font.family: root.ff
                      font.pixelSize: Style.font.caption
                    }

                    Repeater {
                      model: [1, 5, 10, 15, 20, 30]
                      delegate: Button {
                        required property int modelData
                        width: (breakPresetsRow.width - breakPresetsLabel.width - Style.space(6) * 6) / 6
                        text: modelData + "m"
                        selected: root.svc && root.svc.breakMinutes === modelData
                        foreground: root.fg
                        accent: Color.accent
                        fontFamily: root.ff
                        onClicked: if (root.svc) root.svc.breakMinutes = modelData
                      }
                    }
                  }
                }

                PanelSeparator { foreground: root.fg }

                // Automation Rules (Upgraded UI)
                PanelSectionHeader { text: "󰔎 Automation"; foreground: root.fg; fontFamily: root.ff }

                // Auto-start Break Card
                Rectangle {
                  width: parent.width
                  height: Style.space(64)
                  radius: Style.cornerRadius
                  color: (root.svc && root.svc.autoStartBreak) ? Qt.rgba(Color.accent.r, Color.accent.g, Color.accent.b, 0.12) : Qt.rgba(root.fg.r, root.fg.g, root.fg.b, 0.03)
                  border.width: 1
                  border.color: (root.svc && root.svc.autoStartBreak) ? Qt.rgba(Color.accent.r, Color.accent.g, Color.accent.b, 0.3) : Qt.rgba(root.fg.r, root.fg.g, root.fg.b, 0.08)
                  
                  // Smooth background transition
                  Behavior on color { ColorAnimation { duration: 200 } }
                  
                  Row {
                    anchors.fill: parent
                    anchors.leftMargin: Style.space(14)
                    anchors.rightMargin: Style.space(14)
                    spacing: Style.space(14)
                    
                    Text {
                      anchors.verticalCenter: parent.verticalCenter
                      text: "󰅶"
                      color: (root.svc && root.svc.autoStartBreak) ? Color.accent : Qt.darker(root.fg, 1.4)
                      font.family: root.ff
                      font.pixelSize: 24
                    }
                    
                    Text {
                      anchors.verticalCenter: parent.verticalCenter
                      width: parent.width - Style.space(90)
                      text: "Auto-start break"
                      color: root.fg
                      font.family: root.ff
                      font.pixelSize: Style.font.body
                      font.bold: true
                    }
                    
                    // Custom animated switch
                    Rectangle {
                      anchors.verticalCenter: parent.verticalCenter
                      width: Style.space(42)
                      height: Style.space(24)
                      radius: height / 2
                      color: (root.svc && root.svc.autoStartBreak) ? Color.accent : Qt.rgba(root.fg.r, root.fg.g, root.fg.b, 0.2)
                      Behavior on color { ColorAnimation { duration: 200 } }
                      
                      Rectangle {
                        width: Style.space(20)
                        height: Style.space(20)
                        radius: width / 2
                        color: "#ffffff"
                        y: Style.space(2)
                        x: (root.svc && root.svc.autoStartBreak) ? parent.width - width - Style.space(2) : Style.space(2)
                        
                        // Drop shadow effect
                        border.width: 1
                        border.color: Qt.rgba(0,0,0,0.1)
                        
                        Behavior on x { NumberAnimation { duration: 200; easing.type: Easing.OutBack } }
                      }
                    }
                  }
                  
                  MouseArea {
                    anchors.fill: parent
                    onClicked: if (root.svc) root.svc.autoStartBreak = !root.svc.autoStartBreak
                  }
                }

                // Auto-start Focus Card
                Rectangle {
                  width: parent.width
                  height: Style.space(64)
                  radius: Style.cornerRadius
                  color: (root.svc && root.svc.autoStartFocus) ? Qt.rgba(Color.accent.r, Color.accent.g, Color.accent.b, 0.12) : Qt.rgba(root.fg.r, root.fg.g, root.fg.b, 0.03)
                  border.width: 1
                  border.color: (root.svc && root.svc.autoStartFocus) ? Qt.rgba(Color.accent.r, Color.accent.g, Color.accent.b, 0.3) : Qt.rgba(root.fg.r, root.fg.g, root.fg.b, 0.08)
                  
                  // Smooth background transition
                  Behavior on color { ColorAnimation { duration: 200 } }
                  
                  Row {
                    anchors.fill: parent
                    anchors.leftMargin: Style.space(14)
                    anchors.rightMargin: Style.space(14)
                    spacing: Style.space(14)
                    
                    Text {
                      anchors.verticalCenter: parent.verticalCenter
                      text: "󱎫"
                      color: (root.svc && root.svc.autoStartFocus) ? Color.accent : Qt.darker(root.fg, 1.4)
                      font.family: root.ff
                      font.pixelSize: 24
                    }
                    
                    Text {
                      anchors.verticalCenter: parent.verticalCenter
                      width: parent.width - Style.space(90)
                      text: "Auto-start focus"
                      color: root.fg
                      font.family: root.ff
                      font.pixelSize: Style.font.body
                      font.bold: true
                    }
                    
                    // Custom animated switch
                    Rectangle {
                      anchors.verticalCenter: parent.verticalCenter
                      width: Style.space(42)
                      height: Style.space(24)
                      radius: height / 2
                      color: (root.svc && root.svc.autoStartFocus) ? Color.accent : Qt.rgba(root.fg.r, root.fg.g, root.fg.b, 0.2)
                      Behavior on color { ColorAnimation { duration: 200 } }
                      
                      Rectangle {
                        width: Style.space(20)
                        height: Style.space(20)
                        radius: width / 2
                        color: "#ffffff"
                        y: Style.space(2)
                        x: (root.svc && root.svc.autoStartFocus) ? parent.width - width - Style.space(2) : Style.space(2)
                        
                        // Drop shadow effect
                        border.width: 1
                        border.color: Qt.rgba(0,0,0,0.1)
                        
                        Behavior on x { NumberAnimation { duration: 200; easing.type: Easing.OutBack } }
                      }
                    }
                  }
                  
                  MouseArea {
                    anchors.fill: parent
                    onClicked: if (root.svc) root.svc.autoStartFocus = !root.svc.autoStartFocus
                  }
                }
              }
            }

            // Notification Mode Section Card
            Rectangle {
              width: parent.width
              height: notifSettingsCol.implicitHeight + Style.space(24)
              radius: Style.cornerRadius
              color: Qt.rgba(root.fg.r, root.fg.g, root.fg.b, 0.04)
              border.width: 1
              border.color: Qt.rgba(root.fg.r, root.fg.g, root.fg.b, 0.08)

              Column {
                id: notifSettingsCol
                anchors.fill: parent
                anchors.margins: Style.space(12)
                spacing: Style.space(10)

                PanelSectionHeader { text: "󰂚 Completion Reminders"; foreground: root.fg; fontFamily: root.ff }

                Row {
                  width: parent.width
                  spacing: Style.space(8)

                  Button {
                    width: (parent.width - Style.space(8)) / 2
                    text: "󰂚 System Notification"
                    selected: root.svc ? root.svc.reminderMode === "notification" : true
                    fontFamily: root.ff; foreground: root.fg; accent: Color.accent
                    onClicked: if (root.svc) root.svc.reminderMode = "notification"
                  }

                  Button {
                    width: (parent.width - Style.space(8)) / 2
                    text: "󰍹 Fullscreen Overlay"
                    selected: root.svc ? root.svc.reminderMode === "overlay" : false
                    fontFamily: root.ff; foreground: root.fg; accent: Color.accent
                    onClicked: if (root.svc) root.svc.reminderMode = "overlay"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
